{
  "name": "numerals",
  "version": "1.0.0",
  "private": false,
  "description": "Minimalistic calculator for macOS and desktop environments",
  "keywords": [
    "electron",
    "calculator",
    "desktop-app",
    "macos"
  ],
  "main": "main.js",
  "engines": {
    "node": ">=18"
  },
  "build": {
    "mac": {
      "icon": "assets/icon.icns"
    }
  },
  "scripts": {
    "start": "electron-forge start",
    "test": "node --test",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "audit:prod": "npm audit --omit=dev"
  },
  "author": "Devin T",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/devintissen/Numerals.git"
  },
  "bugs": {
    "url": "https://github.com/devintissen/Numerals/issues"
  },
  "homepage": "https://github.com/devintissen/Numerals#readme",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "electron": "^43.3.0"
  },
  "overrides": {
    "@electron/rebuild": "^4.2.0",
    "@electron/asar": "4.2.1",
    "@electron/universal": "3.0.6",
    "tar": "7.5.22",
    "tmp": "^0.2.6",
    "minimatch": "9.0.1",
    "brace-expansion": "2.1.2",
    "node-gyp": "^12.2.0",
    "semver": "^7.6.3"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.0"
  }
}
