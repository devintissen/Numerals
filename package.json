{
  "name": "Numerals",
  "version": "1.1.1",
  "private": false,
  "description": "Minimalistic calculator for macOS and Windows 11",
  "keywords": [
    "electron",
    "calculator",
    "desktop-app",
    "macos"
  ],
  "main": "main.js",
  "engines": {
    "node": "20 || >=22"
  },
  "build": {
    "mac": {
      "icon": "assets/icon.icns"
    }
  },
  "scripts": {
    "start": "electron-forge start",
    "test": "node --test",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "audit:prod": "npm audit --omit=dev"
  },
  "author": "Devin T",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/devintissen/Numerals.git"
  },
  "bugs": {
    "url": "https://github.com/devintissen/Numerals/issues"
  },
  "homepage": "https://github.com/devintissen/Numerals#readme",
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-dmg": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "electron": "^45.3.0"
  },
  "overrides": {
    "@electron/rebuild": "^4.2.0",
    "@electron/asar": "4.2.1",
    "@electron/universal": "3.0.6",
    "tar": "7.5.22",
    "tmp": "^0.2.6",
    "minimatch": "11.0.6",
    "brace-expansion": "5.0.12",
    "node-gyp": "^12.2.0",
    "semver": "^7.6.3",
    "rimraf": {
      "glob": {
        "minimatch": "^3.1.2",
        "brace-expansion": "^1.1.12"
      }
    }
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.0"
  }
}
